{
  "schema": "nose.evidence-artifact-lifecycle.v1",
  "large_file_threshold_bytes": 1048576,
  "lifecycle_classes": {
    "canonical-input": {
      "definition": "A versioned input whose identity is part of a reproducible measurement or release contract.",
      "retention_rule": "Retain while any supported measurement, release, or replay names the input."
    },
    "gold-input": {
      "definition": "Human-adjudicated or otherwise authoritative truth used to score product behavior.",
      "retention_rule": "Never remove without a reviewed replacement, provenance migration, and replayed dependent gates."
    },
    "sealed-evidence": {
      "definition": "Evidence whose pre-commitment, blind review, or reveal boundary must remain immutable.",
      "retention_rule": "Retain the payload and its seal or reveal binder together; replacement does not authorize rewriting history."
    },
    "derived-artifact": {
      "definition": "A reproducible report, packet, census, or calibration derived from identified sources.",
      "retention_rule": "Retain while consumed; remove only after regeneration is documented and no active gate or release depends on it."
    },
    "receipt": {
      "definition": "A compact binding between inputs, outputs, commands, digests, or an execution decision.",
      "retention_rule": "Retain for at least as long as every artifact it binds."
    },
    "active-baseline": {
      "definition": "The current checked comparison point for a fail-closed quality or runtime gate.",
      "retention_rule": "Retain until an explicit superseding baseline passes the same validator and all consumers migrate."
    },
    "historical-evidence": {
      "definition": "A frozen prior result retained for auditability, release reconstruction, or regression attribution.",
      "retention_rule": "Retain while referenced by closeout, release, scorecard, or provenance evidence."
    },
    "superseded-output": {
      "definition": "An output replaced by a named successor and not used as an active comparison point.",
      "retention_rule": "Removal is allowed only after relation and consumer audits prove it is neither gold, sealed, nor release-reconstructing evidence."
    }
  },
