{
  "schema": "nose.incremental_mutation_manifest/v1",
  "minimum_replays": 30,
  "source_identity": {
    "algorithm": "sha256/sorted-relative-path-nul-bytes-v1",
    "includes": ["regular-file-relative-path", "file-bytes"],
    "excludes": ["mtime", "inode", "absolute-checkout-path"]
  },
  "output_identity": {
    "algorithm": "sha256/stdout-bytes-v1",
    "same_binary_rule": "no-cache == empty-store == history-bearing-store",
    "cross_version_rule": "compare documented semantic projection; schema bytes may differ"
  },
  "workloads": {
    "real": [
      {"id": "sympy", "commit": "da4a5fa52418ae593a941d4ba585cfef87a31870"},
      {"id": "prettier", "commit": "a5e7b7c3bd1e783ce33d8b0e335530317fe85bab"},
      {"id": "netty", "commit": "e90eee9f556e3c770dda5ee171276e886266ae71"},
      {"id": "fastlane", "commit": "c30e449d26dc99fa3841f94f3a2a505a676aedbf"}
    ],
    "synthetic": [
      {"id": "synthetic-1k", "files": 1000},
      {"id": "synthetic-10k", "files": 10000},
      {"id": "synthetic-100k", "files": 100000}
    ]
  },
  "mutations": [
    {
      "id": "no-op",
      "kind": "filesystem",
      "changed_inputs": [],
      "expected_invalidation_closure": [],
      "guards": ["warm-no-op", "process-restart", "thread-count", "traversal-order"]
    },
    {
      "id": "leaf-edit",
      "kind": "filesystem",
      "changed_inputs": ["edited-leaf-source"],
      "expected_invalidation_closure": ["edited-leaf-source"]
    },
    {
      "id": "provider-export-edit",
      "kind": "dependency",
      "changed_inputs": ["provider-export"],
      "expected_invalidation_closure": ["provider", "transitive-import-consumers"],
      "regression": "github-issue-275"
    },
    {
      "id": "provider-non-export-edit",
      "kind": "dependency",
      "changed_inputs": ["provider-non-export"],
      "expected_invalidation_closure": ["provider"]
    },
    {
      "id": "high-fanout-provider-edit",
      "kind": "dependency",
      "changed_inputs": ["high-fanout-provider-export"],
      "expected_invalidation_closure": ["provider", "all-transitive-import-consumers"],
      "scaling_rule": "work-proportional-to-affected-closure"
    },
    {
      "id": "add-delete-rename",
      "kind": "filesystem",
      "changed_inputs": ["added-source", "deleted-source", "renamed-source"],
      "expected_invalidation_closure": ["added-source", "deleted-source", "renamed-source", "path-dependent-global-state"]
    },
    {
      "id": "embedded-region-edit",
      "kind": "filesystem",
      "changed_inputs": ["embedded-script-container"],
      "expected_invalidation_closure": ["embedded-script-container"]
    },
    {
      "id": "ignore-exclude-root-change",
      "kind": "analysis-input-set",
      "changed_inputs": ["ignore-rules", "exclude-patterns", "query-roots"],
      "expected_invalidation_closure": ["discovery-set", "presentation-filter"],
      "reusable_layers": ["content-addressed-file-artifacts"]
    },
    {
      "id": "analysis-config-change",
      "kind": "configuration",
      "changed_inputs": ["unit-affecting-analysis-option"],
      "expected_invalidation_closure": ["all-analysis-artifacts"]
    },
    {
      "id": "view-config-change",
      "kind": "configuration",
      "changed_inputs": ["top", "surface", "format"],
      "expected_invalidation_closure": ["presentation"],
      "reusable_layers": ["all-analysis-artifacts"]
    },
    {
      "id": "baseline-ignore-change",
      "kind": "workflow-input",
      "changed_inputs": ["baseline-file", "structured-ignore-file"],
      "expected_invalidation_closure": ["baseline-comparison", "suppression", "presentation"],
      "reusable_layers": ["all-analysis-artifacts"]
    },
    {
      "id": "semantic-pack-change",
      "kind": "semantic-input",
      "changed_inputs": ["pack", "pack-lock", "dependency-evidence"],
      "expected_invalidation_closure": ["pack-influenced-files", "dependent-detection-and-family-state"]
    },
    {
      "id": "swift-global-barrier-change",
      "kind": "corpus-global",
      "changed_inputs": ["swift-overload-or-shadow-declaration"],
      "expected_invalidation_closure": ["swift-files-dependent-on-global-dispatch-proof"]
    },
    {
      "id": "same-size-restored-mtime-edit",
      "kind": "filesystem-adversarial",
      "changed_inputs": ["source-bytes"],
      "expected_invalidation_closure": ["edited-source", "semantic-dependents"],
      "forbidden_identity": "mtime-plus-size"
    },
    {
      "id": "base-branch-switch",
      "kind": "git-state",
      "changed_inputs": ["head-tree", "base-tree", "merge-base"],
      "expected_invalidation_closure": ["changed-files-on-each-side", "divergent-family-state"],
      "implementation_stage": 877
    }
  ]
}
